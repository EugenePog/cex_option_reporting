# Copy to .env and fill in. .env is gitignored.

# --- Database ---
POSTGRES_USER=cex
POSTGRES_PASSWORD=cex
POSTGRES_DB=cex_option_reporting
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full URL used by SQLAlchemy/Alembic (overrides the parts above if set)
DATABASE_URL=postgresql+psycopg://cex:cex@localhost:5432/cex_option_reporting

# --- Security ---
# Fernet key used to encrypt CEX API credentials at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_FERNET_KEY=
# Secret for signing web sessions / JWTs.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# --- Ingestion ---
PIPELINE_INTERVAL_SECONDS=300    # bronze->silver cadence (pipeline --loop)
# Snapshot collector (balance/positions/margin/greeks) — runs at each of these UTC times (HH:MM):
SNAPSHOT_TIMES_UTC=00:00,06:00,12:00,18:00
# History collector (fills/closed-positions/bills) — one run/day at this UTC time (HH:MM), limited depth:
INGEST_TIME_UTC=10:00
INGEST_DAILY_LOOKBACK_DAYS=1     # history window = today + this many previous days
OKX_K_ACCOUNT_LABEL=OKX_K        # label stored on bronze rows for the OKX "K" account

# --- OKX dev account "K" (single-account convenience for local testing) ---
# Used by scripts/okx_positions.py and the OKX adapter. In production, per-account
# credentials live encrypted in the DB (core.cex_account) instead of here.
# Prefer READ-ONLY API keys — the portal only reports.
OKX_K_API_KEY=
OKX_K_API_SECRET=
OKX_K_PASSPHRASE=
OKX_K_FLAG=0                     # "0" live, "1" demo/simulated

# --- Web ---
WEB_HOST=0.0.0.0
WEB_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
